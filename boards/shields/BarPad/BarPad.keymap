#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/studio_unlock.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_MUTE    &kp KP_N7     &kp KP_N8     &kp KP_N9
                &mo 1         &kp KP_N4     &kp KP_N5     &kp KP_N6
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        fn_layer {
            bindings = <
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &studio_unlock   &rgb_ug RGB_BRD
                &trans           &bt BT_CLR       &bt BT_NXT       &bt BT_PRV
            >;
            sensor-bindings = <&inc_dec_kp RGB_HUI RGB_HUD>;
        };
    };
};
